// Fixture of the data laboratory test: a system model with the platform audit table.
generator client {
  provider            = "prisma-client"
  output              = "../generated"
  moduleFormat        = "esm"
  importFileExtension = "js"
}

datasource db {
  provider = "postgresql"
}

model Note {
  id        String   @id @default(uuid()) @db.VarChar(36)
  title     String   @db.VarChar(200)
  body      String?  @db.Text
  createdAt DateTime @default(now()) @map("created_at")

  @@map("note")
}

/// Business audit trail, owned by @solidvs/server (ADR-0016): insert-only, enforced by the
/// database. Keep this model exactly as the platform kit defines it (AUDIT_EVENT_MODEL).
model AuditEvent {
  id          BigInt   @id @default(autoincrement())
  occurredAt  DateTime @map("occurred_at")
  actor       String   @db.VarChar(200)
  action      String   @db.VarChar(100)
  subjectType String   @map("subject_type") @db.VarChar(100)
  subjectId   String?  @map("subject_id") @db.VarChar(200)
  details     String?  @db.Text

  @@index([subjectType, subjectId])
  @@map("audit_event")
}
