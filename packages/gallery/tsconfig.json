{
  "compilerOptions": {
    "target": "ES2022",
    "lib": [
      "ES2022",
      "DOM",
      "DOM.Iterable"
    ],
    "module": "ESNext",
    "moduleResolution": "bundler",
    "jsx": "react-jsx",
    "strict": true,
    "skipLibCheck": true,
    "isolatedModules": true,
    "verbatimModuleSyntax": true,
    "allowImportingTsExtensions": true,
    "noEmit": true,
    "types": [
      "node"
    ],
    "paths": {
      "@solidvs/ui": [
        "../ui/src/index.ts"
      ]
    }
  },
  "include": [
    "src",
    "scripts",
    "vite.config.ts",
    "../ui/src/css.d.ts"
  ]
}
