{
  "realm": "external",
  "displayName": "Usuários externos",
  "enabled": true,
  "loginTheme": "platform",
  "internationalizationEnabled": true,
  "supportedLocales": ["pt-BR"],
  "defaultLocale": "pt-BR",
  "sslRequired": "none",
  "registrationAllowed": false,
  "loginWithEmailAllowed": false,
  "bruteForceProtected": true,
  "accessTokenLifespan": 60,
  "ssoSessionIdleTimeout": 1800,
  "ssoSessionMaxLifespan": 36000,
  "otpPolicyType": "totp",
  "otpPolicyAlgorithm": "HmacSHA1",
  "otpPolicyDigits": 6,
  "otpPolicyPeriod": 30,
  "otpPolicyLookAheadWindow": 1,
  "otpPolicyCodeReusable": true,
  "eventsEnabled": true,
  "eventsListeners": ["jboss-logging", "solidvs-remembered-devices"],
  "adminEventsEnabled": true,
  "attributes": {
    "acr.loa.map": "{\"standard\":1,\"strong\":2}",
    "solidvs.secondFactor.mode": "new-device",
    "solidvs.rememberedDevice.maxAgeDays": "90",
    "solidvs.rememberedDevice.idleDays": "30",
    "solidvs.rememberedDevice.maxDevices": "5"
  },
  "browserFlow": "external browser",
  "authenticationFlows": [
    {
      "alias": "external browser",
      "description": "ADR-0018: level 1 (standard) is the password plus the second factor on a device not remembered; level 2 (strong) asks for the second factor again, for sensitive actions.",
      "providerId": "basic-flow",
      "topLevel": true,
      "builtIn": false,
      "authenticationExecutions": [
        { "authenticator": "auth-cookie", "requirement": "ALTERNATIVE", "priority": 10, "authenticatorFlow": false, "userSetupAllowed": false },
        { "flowAlias": "external forms", "requirement": "ALTERNATIVE", "priority": 20, "authenticatorFlow": true, "userSetupAllowed": false }
      ]
    },
    {
      "alias": "external forms",
      "providerId": "basic-flow",
      "topLevel": false,
      "builtIn": false,
      "authenticationExecutions": [
        { "flowAlias": "external level 1", "requirement": "CONDITIONAL", "priority": 10, "authenticatorFlow": true, "userSetupAllowed": false },
        { "flowAlias": "external level 2", "requirement": "CONDITIONAL", "priority": 20, "authenticatorFlow": true, "userSetupAllowed": false }
      ]
    },
    {
      "alias": "external level 1",
      "providerId": "basic-flow",
      "topLevel": false,
      "builtIn": false,
      "authenticationExecutions": [
        { "authenticatorConfig": "level 1", "authenticator": "conditional-level-of-authentication", "requirement": "REQUIRED", "priority": 10, "authenticatorFlow": false, "userSetupAllowed": false },
        { "authenticator": "auth-username-password-form", "requirement": "REQUIRED", "priority": 20, "authenticatorFlow": false, "userSetupAllowed": false },
        { "flowAlias": "external new device", "requirement": "CONDITIONAL", "priority": 30, "authenticatorFlow": true, "userSetupAllowed": false }
      ]
    },
    {
      "alias": "external new device",
      "providerId": "basic-flow",
      "topLevel": false,
      "builtIn": false,
      "authenticationExecutions": [
        { "authenticator": "solidvs-second-factor-condition", "requirement": "REQUIRED", "priority": 10, "authenticatorFlow": false, "userSetupAllowed": false },
        { "authenticator": "auth-otp-form", "requirement": "REQUIRED", "priority": 20, "authenticatorFlow": false, "userSetupAllowed": false },
        { "authenticator": "solidvs-remember-device", "requirement": "REQUIRED", "priority": 30, "authenticatorFlow": false, "userSetupAllowed": false }
      ]
    },
    {
      "alias": "external level 2",
      "providerId": "basic-flow",
      "topLevel": false,
      "builtIn": false,
      "authenticationExecutions": [
        { "authenticatorConfig": "level 2", "authenticator": "conditional-level-of-authentication", "requirement": "REQUIRED", "priority": 10, "authenticatorFlow": false, "userSetupAllowed": false },
        { "authenticator": "auth-otp-form", "requirement": "REQUIRED", "priority": 20, "authenticatorFlow": false, "userSetupAllowed": false }
      ]
    }
  ],
  "authenticatorConfig": [
    { "alias": "level 1", "config": { "loa-condition-level": "1", "loa-max-age": "36000" } },
    { "alias": "level 2", "config": { "loa-condition-level": "2", "loa-max-age": "300" } }
  ],
  "clients": [
    {
      "clientId": "partner-portal",
      "name": "Portal de parceiros",
      "enabled": true,
      "publicClient": false,
      "clientAuthenticatorType": "client-secret",
      "secret": "{{PARTNER_CLIENT_SECRET}}",
      "standardFlowEnabled": true,
      "directAccessGrantsEnabled": false,
      "implicitFlowEnabled": false,
      "serviceAccountsEnabled": false,
      "redirectUris": ["http://localhost:3998/api/auth/callback"],
      "webOrigins": [],
      "attributes": {
        "pkce.code.challenge.method": "S256",
        "post.logout.redirect.uris": "http://localhost:3998/",
        "acr.loa.map": "{\"standard\":1,\"strong\":2}",
        "default.acr.values": "standard"
      }
    }
  ],
  "users": [
    {
      "username": "carla",
      "enabled": true,
      "firstName": "Carla",
      "lastName": "Mendes",
      "email": "carla@example.test",
      "emailVerified": true,
      "realmRoles": ["default-roles-external"],
      "credentials": [
        { "type": "password", "value": "{{CARLA_PASSWORD}}", "temporary": false },
        {
          "type": "otp",
          "userLabel": "Celular",
          "secretData": "{\"value\":\"{{CARLA_OTP_SECRET}}\"}",
          "credentialData": "{\"subType\":\"totp\",\"digits\":6,\"counter\":0,\"period\":30,\"algorithm\":\"HmacSHA1\"}"
        }
      ]
    }
  ]
}
